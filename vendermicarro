                                                                        type="button" 
                                                                        onClick={() => removeUploadedImage(idx)}
                                                                        className="absolute top-1 right-1 bg-drred-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] shadow opacity-90 hover:opacity-100 transition"
                                                                    >
                                                                        <i className="fa-solid fa-xmark"></i>
                                                                    </button>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        ) : (
                                            <div>
                                                <label className="block text-xs font-semibold text-slate-700 mb-1">URL Foto Principal</label>
                                                <input 
                                                    type="url" 
                                                    placeholder="https://images.unsplash.com/photo-..." 
                                                    value={formData.imageUrl}
                                                    onChange={e => setFormData({...formData, imageUrl: e.target.value})}
                                                    className="w-full p-2.5 border rounded-lg text-sm"
                                                />
                                                <span className="text-[10px] text-slate-400 mt-1 block">Si lo dejas en blanco se asignará una imagen de muestra automáticamente.</span>
                                            </div>
                                        )}

                                        <div>
                                            <label className="block text-xs font-semibold text-slate-700 mb-1">Descripción del Vehículo</label>
                                            <textarea 
                                                rows="3" 
                                                placeholder="Menciona detalles importantes: matrícula al día, mantenimiento, estado de llantas, extras..." 
                                                value={formData.description}
                                                onChange={e => setFormData({...formData, description: e.target.value})}
                                                className="w-full p-2.5 border rounded-lg text-sm"
                                            ></textarea>
                                        </div>
                                    </div>

                                    <div className="pt-4">
                                        <button 
                                            type="submit" 
                                            className="w-full py-3.5 bg-drred-500 hover:bg-drred-600 text-white font-bold rounded-xl shadow-lg transition flex items-center justify-center space-x-2 text-base"
                                        >
                                            <i className="fa-solid fa-paper-plane"></i>
                                            <span>Publicar Vehículo Ahora</span>
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </main>
                    )}

                    {}
                    {activeTab === 'dashboard' && (
                        <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-grow">
                            <div className="flex justify-between items-center mb-6">
                                <div>
                                    <h1 className="text-2xl font-black text-drblue-500">Panel de Control del Vendedor</h1>
                                    <p className="text-xs text-slate-500">Gestiona tus anuncios activos en vendetucarro.com.do 🇩🇴</p>
                                </div>
                                <button 
                                    onClick={() => setActiveTab('publish')}
                                    className="bg-drred-500 hover:bg-drred-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition shadow"
                                >
                                    + Publicar Otro Carro
                                </button>
                            </div>

                            <div className="bg-white rounded-xl shadow border border-slate-200 border-t-4 border-t-drblue-500 overflow-hidden">
                                <div className="p-4 bg-drblue-50 border-b border-slate-100 flex items-center justify-between">
                                    <span className="font-bold text-sm text-drblue-500">Mis Anuncios ({userMyVehicles.length})</span>
                                    <span className="text-xs text-slate-500">Estado en Plataforma</span>
                                </div>

                                <div className="divide-y divide-slate-100">
                                    {userMyVehicles.map(item => (
                                        <div key={item.id} className="p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                                            <div className="flex items-center space-x-4">
                                                <img 
                                                    src={item.images[0]} 
                                                    alt={item.title} 
                                                    className="w-20 h-14 object-cover rounded-lg bg-slate-100"
                                                />
                                                <div>
                                                    <h4 className="font-bold text-slate-900 text-sm">{item.title}</h4>
                                                    <p className="text-xs text-slate-500">{item.province} • {formatDOP(item.priceDOP)}</p>
                                                    <div className="mt-1">
                                                        <span className={`inline-block px-2 py-0.5 rounded text-[10px] font-bold ${item.status === 'Vendido' ? 'bg-slate-200 text-slate-700' : 'bg-drblue-50 text-drblue-500 border border-drblue-100'}`}>
                                                            {item.status}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div className="flex items-center space-x-2 w-full md:w-auto">
                                                {item.status !== 'Vendido' && (
                                                    <button 
                                                        onClick={() => handleMarkAsSold(item.id)}
                                                        className="px-3 py-1.5 bg-drred-50 text-drred-500 hover:bg-drred-100 text-xs font-bold rounded-md transition"
                                                    >
                                                        <i className="fa-solid fa-check-double mr-1"></i>Marcar Vendido
                                                    </button>
                                                )}
                                                <button 
                                                    onClick={() => setSelectedVehicle(item)}
                                                    className="px-3 py-1.5 bg-drblue-50 hover:bg-drblue-100 text-drblue-500 text-xs font-bold rounded-md transition"
                                                >
                                                    Ver Anuncio
                                                </button>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </main>
                    )}

                    {}
                    {selectedVehicle && (
                        <div className="fixed inset-0 z-50 flex items-center justify-center bg-drblue-900/70 backdrop-blur-sm p-4 overflow-y-auto">
                            <div className="bg-white rounded-2xl shadow-2xl max-w-3xl w-full overflow-hidden my-8 relative animate-in fade-in zoom-in duration-200 border-t-8 border-drblue-500">
                                
                                <button 
                                    onClick={() => setSelectedVehicle(null)}
                                    className="absolute top-4 right-4 z-10 bg-slate-900/60 hover:bg-drred-500 text-white rounded-full w-8 h-8 flex items-center justify-center transition"
                                >
                                    <i className="fa-solid fa-xmark"></i>
                                </button>

                                <div className="relative h-64 sm:h-80 bg-slate-900">
                                    <img 
                                        src={selectedVehicle.images[0]} 
                                        alt={selectedVehicle.title} 
                                        className="w-full h-full object-cover"
                                    />
                                    <div className="absolute bottom-4 left-4 bg-drblue-500/90 backdrop-blur text-white px-3 py-1 rounded-full text-xs font-semibold">
                                        <i className="fa-solid fa-location-dot mr-1 text-drred-500"></i>{selectedVehicle.province}, Rep. Dom.
                                    </div>
                                </div>

                                <div className="p-6">
                                    <div className="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-4 border-b pb-4">
                                        <div>
                                            <span className="text-xs font-extrabold uppercase tracking-wide text-drred-500">{selectedVehicle.condition}</span>
                                            <h2 className="text-2xl font-black text-drblue-500">{selectedVehicle.title}</h2>
                                        </div>
                                        <div className="text-left md:text-right">
                                            <div className="text-2xl font-black text-drblue-500">{formatDOP(selectedVehicle.priceDOP)}</div>
                                            <div className="text-sm font-bold text-drred-500">{formatUSD(selectedVehicle.priceUSD)}</div>
                                        </div>
                                    </div>

                                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-drblue-50/50 p-4 rounded-xl mb-6 border border-drblue-100">
                                        <div>
                                            <span className="block text-[10px] uppercase font-bold text-drblue-500">Año</span>
                                            <span className="font-bold text-slate-800 text-sm">{selectedVehicle.year}</span>
                                        </div>
                                        <div>
                                            <span className="block text-[10px] uppercase font-bold text-drblue-500">Kilometraje/Millas</span>
                                            <span className="font-bold text-slate-800 text-sm">{selectedVehicle.mileage}</span>
                                        </div>
                                        <div>
                                            <span className="block text-[10px] uppercase font-bold text-drblue-500">Transmisión</span>
                                            <span className="font-bold text-slate-800 text-sm">{selectedVehicle.transmission}</span>
                                        </div>
                                        <div>
                                            <span className="block text-[10px] uppercase font-bold text-drblue-500">Combustible</span>
                                            <span className="font-bold text-slate-800 text-sm">{selectedVehicle.fuel}</span>
                                        </div>
                                    </div>

                                    <div className="mb-6">
                                        <h4 className="font-bold text-slate-900 text-sm mb-2">Descripción del vendedor:</h4>
                                        <p className="text-xs text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-lg border border-slate-100">
                                            {selectedVehicle.description}
                                        </p>
                                    </div>

                                    <div className="bg-slate-50 border border-slate-200 p-4 rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4">
                                        <div className="flex items-center space-x-3 w-full sm:w-auto">
                                            <div className="w-10 h-10 rounded-full bg-drblue-500 text-white font-bold flex items-center justify-center text-lg shadow">
                                                {selectedVehicle.sellerName.charAt(0)}
                                            </div>
                                            <div>
                                                <span className="text-[10px] uppercase font-bold text-drred-500">Vendedor Verificado RD</span>
                                                <h5 className="font-bold text-slate-900 text-sm">{selectedVehicle.sellerName}</h5>
                                            </div>
                                        </div>

                                        <div className="flex items-center gap-2 w-full sm:w-auto">
                                            <a 
                                                href={`tel:${selectedVehicle.sellerPhone}`}
                                                className="flex-1 sm:flex-none py-2.5 px-4 bg-drblue-500 hover:bg-drblue-600 text-white rounded-lg text-xs font-bold transition text-center"
                                            >
                                                <i className="fa-solid fa-phone mr-1"></i>Llamar
                                            </a>
                                            <a 
                                                href={getWhatsAppLink(selectedVehicle)}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                className="flex-1 sm:flex-none py-2.5 px-5 bg-whatsapp-500 hover:bg-whatsapp-600 text-white rounded-lg text-xs font-bold transition flex items-center justify-center space-x-2 shadow"
                                            >
                                                <i className="fa-brands fa-whatsapp text-base"></i>
                                                <span>Contactar por WhatsApp</span>
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    )}

                    {}
                    <footer className="bg-drblue-500 text-slate-200 text-xs py-8 border-t-4 border-drred-500">
                        <div className="max-w-7xl mx-auto px-4 text-center">
                            <p className="font-bold text-white text-base mb-2">vendetucarro<span className="text-drred-500">.com.do</span> 🇩🇴</p>
                            <p className="mb-4 text-slate-300">El portal patriótico para comprar y vender vehículos usados en República Dominicana.</p>
                            <p className="text-slate-400">© 2026 vendetucarro.com.do - Todos los derechos reservados.</p>
                        </div>
                    </footer>

                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
